{
  "name": "soundisle-activity-lab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "build:split": "tsc --noEmit && vite build --config vite.split.config.ts",
    "inline": "node scripts/inline.mjs",
    "serve": "node server/mock-api.mjs",
    "verify": "bash scripts/verify.sh",
    "check:async": "node scripts/async-check.mjs",
    "check:dom": "node scripts/jsdom-check.mjs",
    "check:style": "node scripts/style-check.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^30.1.1",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "vite-plugin-singlefile": "^2.3.0"
  }
}