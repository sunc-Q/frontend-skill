    "fresnel": {
      "blocks": [
        "float fresnelTerm(vec3 viewDir, vec3 normal, float power) {\n  return pow(1.0 - max(dot(normalize(viewDir), normalize(normal)), 0.0), power);\n}\n"
      ],
      "signatures": [
        "float fresnelTerm("
      ]
    },
    "dissolve": {
      "blocks": [
        "float dissolveMask(float noiseValue, float progress) {\n  return step(progress, noiseValue);\n}\n\nfloat dissolveEdge(float noiseValue, float progress, float edgeWidth) {\n  return smoothstep(progress, progress + edgeWidth, noiseValue);\n}\n"
      ],
      "signatures": [
        "float dissolveMask(",
        "float dissolveEdge("
      ]
    },
    "ripple": {
      "blocks": [
        "float rippleRing(vec2 uv, float time) {\n  vec2 p = uv * 2.0 - 1.0;\n  float dist = length(p);\n  float wave = sin(dist * 24.0 - time * 4.0);\n  return smoothstep(0.2, 0.21, wave) - smoothstep(0.21, 0.22, wave);\n}\n"
      ],
      "signatures": [
        "float rippleRing("
      ]
    },
    "scanline": {
      "blocks": [
        "float scanlineMask(float coord, float time, float density, float strength) {\n  float scan = 0.5 + 0.5 * sin(coord * density + time * 6.0);\n  return mix(1.0 - strength, 1.0, scan);\n}\n"
      ],
      "signatures": [
        "float scanlineMask("
      ]
    },
    "pixelate": {
      "blocks": [
        "vec2 pixelateUv(vec2 uv, vec2 pixelSize) {\n  return floor(uv * pixelSize) / pixelSize;\n}\n"
